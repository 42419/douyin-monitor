# ============================================================================
# dywatch 配置模板 —— 复制为 .env 后填写
#   cp .env.example .env && chmod 600 .env
#
# 每一项的完整说明见 https://dywatch.yunov.top/config/reference；
# 本文件由 src/dywatch/settings.py 的 SETTINGS 生成，代码里有的这里一定有，反之亦然。
# ============================================================================

# ---------------------------------------------------------------- 上游 DTK v5
# 与 DTK 同机部署时保持回环地址（DTK 默认只发布到 127.0.0.1）
DTK_BASE_URL=http://127.0.0.1:8000

# 必填。在 DTK 控制台「用户与 API 密钥」创建，完整 Key 只在创建时显示一次。
# 形态必须是 dtk_<12位十六进制>_<32位base64url>（共 49 字符）
DTK_API_KEY=

# 需要的 scope 只有两个：douyin:read、archive:read
#   douyin:read   -> user/posts、video、tools/parse-url、tasks/{id}
#   archive:read  -> archive 交叉确认
# 角色 viewer 就够（这些端点只按 scope 鉴权）

# ?wait= 秒数：让服务端替我们长轮询，一次往返拿结果。0 表示走纯异步（202+轮询）
DTK_WAIT=25
# HTTP 超时，必须大于 DTK_WAIT
DTK_TIMEOUT=35
# 必须为 true：否则命中 DTK 的 300 秒列表缓存 + 请求合并，监控粒度会静默变成 5 分钟
DTK_REFRESH=true

# 置顶标志（raw.is_top）的获取策略：auto / always / never
#   auto   仅在新作品 / 标题变更 / 每 RAW_REFRESH_ROUNDS 轮带一次 include_raw
#   always 每轮都带（响应体积约 ×3）
#   never  从不带，置顶一律按非置顶处理，删除确认退化为统一 2 轮
INCLUDE_RAW=auto
RAW_REFRESH_ROUNDS=20

DTK_USER_AGENT=dywatch/0.1

# ---------------------------------------------------------------- 请求节奏
# 全局相邻请求间隔（秒，随机）。与并发数无关：并发只为不让慢账号拖累别人。
# 实测这套节奏（3~8 秒 + 轮末 15~40 秒）可长期稳定运行，不要随意改动。
REQUEST_INTERVAL_MIN=3
REQUEST_INTERVAL_MAX=8
# 轮末随机等待（秒）
POLL_INTERVAL_MIN=15
POLL_INTERVAL_MAX=40
# 并发上限
MAX_CONCURRENT=5

# 单页拉取条数。注意：抖音返回的是 count + 本页置顶数，所以它不是硬上限。
# 上限 50。调大能降低漏检，代价是每轮响应体积同比增加（约 36 KB/条）。
FETCH_COUNT=15

# ---------------------------------------------------------------- 判定规则
# 作品消失确认轮数（连续几轮不在本页才认定为删除）
DELETE_CONFIRM_ROUNDS=2
DELETE_CONFIRM_ROUNDS_TOP=3
DELETE_CONFIRM_ROUNDS_ALL=3
# 每账号跟踪的作品上限；超出后优先淘汰最旧的非置顶
KNOWN_IDS_MAX=50
# tombstone（防窗口回移重复推送）的条数上限与存活天数
REMOVED_MAX=200
REMOVED_TTL_DAYS=7
# 账号始终没有返回作品时，连续几轮后告警「请核实 sec_user_id」
EMPTY_ROUNDS_ALERT=3
# 距上次更新多少天没新作品 -> 一次性兜底提醒
STALE_FALLBACK_DAYS=14

# ---------------------------------------------------------------- 失败与退避
# 连续失败几次告警
MAX_CONSECUTIVE_FAILS=5
# 同类失败告警的冷却（秒）
FAIL_COOLDOWN=300
# 上游 429/503 触发全局闸门后，退避从多少秒起、封顶多少秒
BACKOFF_AFTER=2
BACKOFF_MAX_SECONDS=600

# ---------------------------------------------------------------- 归档交叉确认
# true：删除判定时读 DTK 本地归档的 availability 作为第二信源（零身份成本）
ARCHIVE_ENABLED=true

# ---------------------------------------------------------------- 归档下载（可选写操作）
# true：检测到新作品时，请 DTK 把这条作品的媒体存一份到它自己的磁盘上
#       （见 https://dywatch.yunov.top/guide/archive-download）
#       需要给 API Key 加上 media:write 权限；下载请求之间会自动留间隔，不会一口气全发出去
ARCHIVE_DOWNLOAD_ENABLED=false
# 存下来的媒体要不要"永久保留"：
#   false（默认）—— DTK 的媒体目录默认最多用 2G，超过就自动删最旧的，
#                   也就是只留"最近这一批"，旧的会被新下载的顶掉
#   true          —— 每一份都锁定，永远不自动删；但 2G 装满之后新的下载会一直失败，
#                   需要你自己去 DTK 那边手动删掉一些腾地方
ARCHIVE_DOWNLOAD_PIN=false
# 每轮最多触发几条下载。超出的不会丢，排到下一轮继续
ARCHIVE_DOWNLOAD_MAX_PER_ROUND=10

# ---------------------------------------------------------------- 隐藏作品核验（可选，需要更高权限）
# true：游客身份有时看不到作者主页最新发布的作品（抖音的访客限制，与本工具无关）。
#       开启后核对作者的发布总数：对不上时才用一次登录态身份把列表重新拉一遍，
#       分清"这条只是对访客不可见"还是"作者真删了"。被判定为对访客不可见的作品会
#       打上标记，之后不再按游客视角判定它的消失。
#       五种触发时机：账号初始化 / 本轮有新作品 / 有作品被确认消失 / 长期无更新兜底 /
#       低频保底（HIDDEN_CHECK_INTERVAL_MINUTES），其余轮次不产生任何额外请求。
HIDDEN_POST_CHECK_ENABLED=false
# 低频保底间隔（分钟，0 = 关闭）：基准值超过这么久没核对过就无条件核对一次。
# 这条是必需的，不是优化——"新作品从发布起就不可见"和"对访客不可见的作品被删"
# 这两类变化在游客视角完全不留痕迹，只靠事件触发永远等不到它们。
# 代价：每账号每 30 分钟一次请求（相对每账号每轮的抓取可忽略）。
HIDDEN_CHECK_INTERVAL_MINUTES=30
# 登录态身份的 UUID（DTK 控制台 Identities 页面可查）。HIDDEN_POST_CHECK_ENABLED=true 时必填。
# 需要 Key 带 identity:manage scope，且 Key 的 owner 账号至少 operator
PINNED_IDENTITY_ID=
# 定向核验专用的 Key（留空则复用 DTK_API_KEY）。identity:manage 能解密查看任意身份的
# cookie 明文，权限比监控本身重得多，建议单独开一把 Key、只给这一处用，
# 泄露的影响面才不会牵连到主监控用的只读凭据
PIN_DTK_API_KEY=

# ---------------------------------------------------------------- 通知
# 通知目标（推荐；**同一个类型可以配多个实例**，比如两个钉钉群、两个 Telegram 会话）：
#   一行一个目标：每行第一个词是类型，后面是 key=value，字段之间用**空格或逗号**分隔
#   `#` 前有空格（或在行首）才是注释——想临时停掉某个渠道就把它注释掉，不用删
#   各类型可用的字段：
#     dingtalk token[,secret]        wecom key            bark device_key[,server]
#     serverchan sendkey             telegram bot_token chat_id          webhook url
#   name= 是**实例名**：会出现在投递记录与只读面板里，所以必须唯一；不写就按类型自动编号
#   （dingtalk / dingtalk-2 / dingtalk-3 …）
#   值里要带空格、逗号或 #（URL 里就可能有逗号或片段）就加引号，例如 url='https://x/a,b#frag'
#   值里本身要出现引号字符（比如英文名带撇号 name=O'Brien）也要整体加引号：name="O'Brien"，
#   裸着写解析器会当成引号开头，可能把下一行的目标悄悄吞掉一截
#   ⚠ 多行值里再用引号时，**必须换一种**：外层是 " 内层就用 '（同一种会让 .env 解析器把整个键丢掉）
#   写法（.env 支持带引号的多行值）：
#     NOTIFY_TARGETS="
#     dingtalk name=市场部, token=xxx, secret=SECyyy
#     dingtalk name=运营群, token=zzz
#     telegram bot_token=1:AA, chat_id=-100
#     "
#   配了这一项之后，下面的 NOTIFY_CHANNELS 与各"单值凭据键"会被忽略（启动时会提示）。
NOTIFY_TARGETS=

# 旧写法（一个类型只能一个实例，继续可用）：启用的渠道，逗号分隔，可多开
NOTIFY_CHANNELS=dingtalk
# 静默模式：跳过全部推送，监控 / 状态 / 面板照常
SILENT_MODE=false
# 相邻两条通知的间隔（秒），避免被渠道限流
NOTIFY_GAP=1.0

# 钉钉（加签机器人）：DINGTALK_SECRET 必须以 SEC 开头
DINGTALK_TOKEN=
DINGTALK_SECRET=
# 告警时 @ 的手机号，逗号分隔
AT_MOBILES=

# 企业微信群机器人
WECOM_WEBHOOK_KEY=

# Bark（iOS）
BARK_SERVER=https://api.day.app
BARK_DEVICE_KEY=

# Server 酱
SERVERCHAN_SENDKEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 通用 webhook（POST JSON）
WEBHOOK_URL=

# ---------------------------------------------------------------- 只读面板
WEB_ENABLED=false
# 无鉴权，默认只听回环。要暴露到局域网/公网请自行加反向代理鉴权
WEB_HOST=127.0.0.1
WEB_PORT=8787

# ---------------------------------------------------------------- 其他
# 终端日志级别（不影响日志文件内容）
LOG_LEVEL=INFO
# 工作目录：状态库、日志、users.conf 都在这里。
# **留空 = 用当前工作目录**（注册表默认值）。别在这里写死一个绝对路径：
# install.sh 会把这个文件原样复制成 .env，写死之后按 README 用别的目录安装
# （sudo MONITOR_HOME=/srv/dywatch bash deploy/install.sh）就会让数据落到旧路径。
# 服务不受这一项影响——systemd 单元显式传了 MONITOR_HOME；手跑 CLI 时先 cd 到安装目录。
MONITOR_HOME=
# 保留天数。轮次周期只有几十秒，rounds 是唯一会持续长大的表
# （1 个账号 ≈ 每天 2600 行，5 天约 1.3 万行）；这张表没有任何读取方，纯排障用，
# 所以默认只留 5 天。改小后下一轮就会删掉超期行，但文件不会自己变小。
EVENTS_KEEP_DAYS=30
ROUNDS_KEEP_DAYS=5
